# ═══════════════════════════════════════════════════════════════
# Eidovia — Root Environment Template
#
# HOW TO USE:
#   Copy-Item .env.example .env        (Windows)
#   cp .env.example .env               (Linux/macOS)
#   Then fill in every value marked  ← REQUIRED
#
# RULES:
#   ✅  .env.example  — commit this (no real secrets, just shape)
#   ❌  .env          — NEVER commit (gitignored)
#
# SPECIAL CASE — Expo mobile app:
#   EXPO_PUBLIC_* must also live in  Mobile/app/.env
#   (Expo Metro bundler only reads .env next to package.json)
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
# DATABASE  (shared by AI service + API gateway)
# ───────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
# Host-side port. 5432 is blocked by Windows Hyper-V → use 6543.
DATABASE_PORT=6543
POSTGRES_PORT=6543          # used by docker-compose port mapping
POSTGRES_USER=appuser
DB_PASSWORD=                # ← REQUIRED  (choose a strong password)
POSTGRES_DB=eidovia

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False


# ───────────────────────────────────────────────────────────────
# REDIS  (AI service only)
# ───────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=             # ← REQUIRED  (choose a strong password)
REDIS_DB=0

# TTL settings (seconds)
REDIS_TTL_SESSION_STATE=3600
REDIS_TTL_PROFILE=7200


# ───────────────────────────────────────────────────────────────
# AUTH  (API gateway)
# ───────────────────────────────────────────────────────────────
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=                 # ← REQUIRED  (minimum 32 characters)
JWT_EXPIRES_MINUTES=10080   # 7 days
BCRYPT_ROUNDS=12            # keep 10-12 for prod; 4 for tests only


# ───────────────────────────────────────────────────────────────
# AI SERVICE
# ───────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8001

# WebSocket
WS_TIMEOUT=10.0
WS_MAX_FRAME_SIZE=1000000

# Request timeout
REQUEST_TIMEOUT=5.0

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_THRESHOLD=0.40
RAG_TOP_K=3
RAG_TIMEOUT=5.0

# Bandit
BANDIT_EPSILON=0.15
BANDIT_STATE_DIM=8

# ETL Scheduler
ETL_REFRESH_INTERVAL=60
ETL_SESSION_WINDOW=30

# Feature flags
DEBUG=False
MOCK_LLM=True               # True = return retrieved text, no LLM call


# ───────────────────────────────────────────────────────────────
# API GATEWAY
# ───────────────────────────────────────────────────────────────
# Use 0.0.0.0 so a phone on the same Wi-Fi can reach the gateway.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# AI service proxy
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30

# Seed data — used by:  python -m scripts.setup_db
SEED_USER_USERNAME=demo_student
SEED_USER_EMAIL=demo.student@example.com
SEED_USER_PASSWORD=         # ← set to seed a test user (optional)
SEED_USER_LANGUAGE=en


# ───────────────────────────────────────────────────────────────
# MOBILE APP  (Expo — build-time only, never put secrets here)
# ───────────────────────────────────────────────────────────────
# Also copy this value into  Mobile/app/.env  — Expo requires it
# to be next to package.json.
#
# Physical phone (same Wi-Fi):   http://<YOUR-PC-LAN-IP>:8000
#   Find PC IP:  ipconfig  → "IPv4 Address" under Wi-Fi adapter
# Android emulator:              http://10.0.2.2:8000
# iOS Simulator (macOS):         http://localhost:8000
EXPO_PUBLIC_API_URL=http://192.168.0.100:8000
