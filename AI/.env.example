# Copy this file to .env and fill in values. Do not commit the real .env.

# ─── PostgreSQL (pgvector/pgvector:pg16) ───
POSTGRES_USER=appuser
DB_PASSWORD=changeme_strong_password
POSTGRES_DB=eduarai
POSTGRES_PORT=5432

# ─── Redis (redis:7-alpine) ───
REDIS_PASSWORD=changeme_strong_password
REDIS_PORT=6379

# ─── Connection strings for application services ───
# Use these in your gateway / ai-service .env:
#
#   DATABASE_URL=postgresql+asyncpg://appuser:<DB_PASSWORD>@localhost:5432/eduarai
#   REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
#
# If connecting from another Docker container on the same network,
# replace "localhost" with the container name:
#
#   DATABASE_URL=postgresql+asyncpg://appuser:<DB_PASSWORD>@eduarai_postgres:5432/eduarai
#   REDIS_URL=redis://:<REDIS_PASSWORD>@eduarai_redis:6379/0
