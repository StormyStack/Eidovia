# EduAR-AI API Gateway settings.
# Copy to apps/gateway/.env and fill in the blanks. Never commit .env (it is gitignored).

# --- Database: same variable names and values as the team's root .env ---
# Use localhost when the gateway runs on your PC and Postgres runs in Docker.
DATABASE_HOST=localhost
DATABASE_PORT=5432
POSTGRES_USER=appuser
DB_PASSWORD=
POSTGRES_DB=eduarai

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=10080
BCRYPT_ROUNDS=12

# --- Server ---
# Use 0.0.0.0 to reach the gateway from a phone on the same Wi-Fi (see README).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# --- Seed data (python -m scripts.setup_db) ---
SEED_USER_USERNAME=demo_student
SEED_USER_EMAIL=demo.student@example.com
SEED_USER_PASSWORD=
SEED_USER_LANGUAGE=en
