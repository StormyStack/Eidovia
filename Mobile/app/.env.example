# Copy this file to .env (gitignored) and set the Gateway URL for YOUR setup.
# EXPO_PUBLIC_* values are embedded in the app bundle and visible to anyone: never put secrets here.
# After changing .env, restart Metro with:  npx expo start --clear
#
# Physical Android phone (same Wi-Fi as the PC): use the PC's LAN IP, e.g. http://192.168.0.105:8000
#   Find it with:  ipconfig   (look for "IPv4 Address" under your Wi-Fi adapter)
# Android emulator on the same PC:                http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://192.168.0.100:8000
