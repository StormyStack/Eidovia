# ═══════════════════════════════════════════════════════════════
# Eidovia — Unified Root .gitignore
# Covers: AI service (Python), Mobile/gateway (Python/FastAPI),
#         Mobile/app (React Native / Expo)
# ═══════════════════════════════════════════════════════════════

# ─── Secrets & environment ─────────────────────────────────────
.env
.env.local
.env.*.local
# Keep templates — they contain no real values
!.env.example
!**/.env.example

# ─── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
*.so
.coverage
.coverage.*
htmlcov/
coverage/

# ─── Node / JavaScript ─────────────────────────────────────────
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*

# ─── Expo / React Native ───────────────────────────────────────
.expo/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# Generated native folders (Expo managed workflow)
Mobile/app/ios/
Mobile/app/android/

# ─── Mobile signing & certificates ────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*
.kotlin/

# ─── Local dev database (scripts/dev_db.py) ───────────────────
.devdb/

# ─── OS / Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# ─── Logs ──────────────────────────────────────────────────────
*.log

# Eidovia AR game: generated native projects and the Unity export (re-created by prebuild / Unity)
apps/mobile/android/
apps/mobile/ios/
apps/mobile/unity/builds/
apps/mobile/dist/