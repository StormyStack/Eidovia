# ═══════════════════════════════════════════════════════════════
# Eidovia — Unified Root .gitignore
# Covers: AI service (Python), Mobile/gateway (Python/FastAPI),
#         Mobile/app (React Native / Expo)
# ═══════════════════════════════════════════════════════════════

# ─── Secrets & environment ─────────────────────────────────────
.env
.env.local
.env.*.local
# Keep templates — they contain no real values
!.env.example
!**/.env.example

# ─── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
*.so
.coverage
.coverage.*
htmlcov/
coverage/

# ─── Node / JavaScript ─────────────────────────────────────────
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*

# ─── Expo / React Native ───────────────────────────────────────
.expo/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# Generated native folders (Expo managed workflow)
Mobile/app/ios/
Mobile/app/android/

# ─── Mobile signing & certificates ────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*
.kotlin/

# ─── Local dev database (scripts/dev_db.py) ───────────────────
.devdb/

# ─── OS / Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# ─── Logs ──────────────────────────────────────────────────────
*.log

# Eidovia AR game: generated native projects and the Unity export (re-created by prebuild / Unity)
apps/mobile/android/
apps/mobile/ios/
apps/mobile/unity/builds/

# ─── Unity (AR components) ─────────────────────────────────────
# Generated by the Unity Editor, never committed
/AR components/[Ll]ibrary/
/AR components/[Tt]emp/
/AR components/[Oo]bj/
/AR components/[Bb]uild/
/AR components/[Bb]uilds/
/AR components/[Ll]ogs/
/AR components/[Uu]ser[Ss]ettings/
/AR components/[Mm]emoryCaptures/
/AR components/[Rr]ecordings/
/AR components/Assets/_Recovery/
/AR components/Assets/_Recovery.meta
/AR components/*_BurstDebugInformation_DoNotShip/
/AR components/.vs/
/AR components/*.csproj
/AR components/*.sln
/AR components/*.suo
/AR components/*.user
*.apk
*.aab
# Released app: only apps/mobile/dist/Eidovia-release.apk is committed (Git LFS, see .gitattributes)
!apps/mobile/dist/
apps/mobile/dist/*
!apps/mobile/dist/Eidovia-release.apk
# ─── App signing key (NEVER commit; keep a private backup) ─────
apps/mobile/credentials/
